# انسخ هذا الملف إلى .env واملأ القيم. دون قيم Supabase يعمل الموقع في الوضع التجريبي (بيانات في المتصفح فقط).

# من Supabase › Project Settings › API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# المفتاح العام لميسر (pk_test_... في مرحلة الاختبار). دونه يظهر زر «محاكاة الدفع».
VITE_MOYASAR_PUBLISHABLE_KEY=
# طرق الدفع الظاهرة في نموذج ميسر، مفصولة بفواصل: creditcard,stcpay,applepay
VITE_MOYASAR_METHODS=creditcard

# متغيرات الخادم: تُضاف في Netlify › Site configuration › Environment variables فقط، ولا توضع في الواجهة.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MOYASAR_SECRET_KEY=
